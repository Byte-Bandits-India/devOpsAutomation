[Unit]
Description=PM2 process manager
Documentation=https://pm2.keymetrics.io/
After=network.target

[Service]
Type=forking
User=ec2-user
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
Environment=PATH=/usr/bin:/usr/local/bin:/usr/sbin:/usr/local/sbin
Environment=PM2_HOME=/home/ec2-user/.pm2
PIDFile=/home/ec2-user/.pm2/pm2.pid
Restart=on-failure

ExecStart=/usr/lib/nodejs22/lib/node_modules/pm2/bin/pm2 resurrect
ExecReload=/usr/lib/nodejs22/lib/node_modules/pm2/bin/pm2 reload all
ExecStop=/usr/lib/nodejs22/lib/node_modules/pm2/bin/pm2 kill

[Install]
WantedBy=multi-user.target
